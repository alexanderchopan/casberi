        }
      }
    },
    "Checked that the transaction was really authorised by the account — the step that replaces a signature." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprobó que la cuenta autorizó realmente la transacción: el paso que sustituye a una firma."
