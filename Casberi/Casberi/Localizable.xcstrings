    "Read-only — never chats or follows.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用 — チャットやフォローには一切触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 — 대화나 팔로우는 읽지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读 — 绝不涉及对话或关注。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura — nunca chats ni seguidos."
          }
        }
      }
    },
    "Read-only — never edits a note.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用 — ノートを編集することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 — 노트를 수정하지 않아요."
