            "value": "Copia el token de API que se muestra ahí."
          }
        }
      }
    },
    "Couldn't connect %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を接続できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 연결하지 못했어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 %@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar %@."
          }
        }
      }
    },
    "Couldn't find that %@ — check the spelling.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その%@が見つかりませんでした — つづりを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 찾지 못했어요 — 철자를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到那个%@ — 检查一下拼写。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ese %@ — revisa la ortografía."
          }
        }
      }
    },
    "Couldn't find that token — try its contract address.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのトークンが見つかりませんでした — コントラクトアドレスを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰을 찾지 못했어요 — 컨트랙트 주소로 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到那个代币 — 试试它的合约地址。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ese token — prueba con su dirección de contrato."
          }
        }
      }
    },
    "Couldn't keep access to that folder — try picking it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダへのアクセスを保持できませんでした — もう一度選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 접근 권한을 유지하지 못했어요 — 다시 선택해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保持对那个文件夹的访问 — 试着重新选择它。"
          }
