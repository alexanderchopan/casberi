    },
    "Couldn't refresh %@ just now — your saved token may need renewing.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を今すぐ更新できませんでした — 保存されたトークンの更新が必要かもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 %@을(를) 새로고침하지 못했어요 — 저장된 토큰을 갱신해야 할 수 있어요."
          }
        },
        "zh-Hans": {
