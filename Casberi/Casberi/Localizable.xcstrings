    "That key can %@ — make a view-only one and paste that instead. It wasn't saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esa clave puede %@ — crea una de solo lectura y pégala en su lugar. No se guardó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "そのキーは%@できます — 表示専用のキーを作成して代わりに貼り付けてください。保存されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "해당 키는 %@할 수 있습니다 — 보기 전용 키를 만들어 대신 붙여넣으세요. 저장되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
