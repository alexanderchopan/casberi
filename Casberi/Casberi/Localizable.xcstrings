    },
    "Paste an address, or pick one that was just created below. Watching is free and reads only." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pega una dirección, o elige una que se acaba de crear abajo. Vigilar es gratis y solo de lectura."
