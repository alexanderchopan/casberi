    },
    "Read-only — never trades or moves funds.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用 — 取引や資金移動は一切行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 — 거래하거나 자금을 옮기지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
