    "Disconnected — your things stay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado — tus cosas se quedan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を解除しました — あなたの thing は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 해제됨 — 내 항목은 그대로 남아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开连接 — 你的内容会保留。"
          }
        }
      }
    },
    "Disconnecting stops syncing. Its balance leaves your combined total. What already landed stays yours.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desconectar detiene la sincronización. Su saldo sale de tu total combinado. Lo que ya llegó sigue siendo tuyo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続を解除すると同期が止まります。その残高は合計から除外されます。すでに取り込まれたものはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결을 해제하면 동기화가 중지됩니다. 잔액은 합산 총액에서 제외됩니다. 이미 들어온 항목은 그대로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "断开连接后将停止同步。其余额会从合并总额中移除。已经同步的内容仍然保留。"
          }
        }
      }
    },
    "Disconnecting stops syncing. What already landed stays yours.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al desconectar se detiene la sincronización. Lo que ya llegó sigue siendo tuyo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続を解除すると同期が止まります。すでに届いたものはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결을 해제하면 동기화가 멈춰요. 이미 담긴 것은 그대로 남아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "断开会停止同步。已经落地的内容仍归你所有。"
