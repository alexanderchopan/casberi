          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続されましたが「このアプリが接続する先」に記載されていません — 隠しサービスではなく、リストの不具合です。ご報告ください。"
          }
        },
        "ko": {
          "stringUnit": {
