        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读 — 绝不编辑笔记。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura — nunca edita una nota."
          }
        }
      }
    },
    "Read-only — never sends.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用 — 送信することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 — 절대 보내지 않아요."
