    "Your latest %@ post shows on Home. Turn this off — or long-press the card — to remove it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の %@ の投稿がホームに表示されます。これをオフにする — またはカードを長押し — すると外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 %@ 게시물이 홈에 표시돼요. 이걸 끄거나 — 카드를 길게 눌러 — 제거할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最新的 %@ 帖子会显示在主页。关闭此项 — 或长按卡片 — 即可移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu última publicación de %@ aparece en Inicio. Desactiva esto — o mantén pulsada la tarjeta — para quitarla."
          }
        }
      }
    },
    "Removed from Home. Turn this on to show your latest %@ post again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームから外しました。これをオンにすると最新の %@ の投稿が再び表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈에서 제거했어요. 이걸 켜면 최신 %@ 게시물이 다시 표시돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从主页移除。开启此项可再次显示你最新的 %@ 帖子。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitado de Inicio. Activa esto para volver a mostrar tu última publicación de %@."
          }
        }
      }
    },
