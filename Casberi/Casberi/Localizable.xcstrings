    "%@ fills your week — %lld things across %lld app%@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ fills your week — %2$lld things across %3$lld app%4$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今週は%1$@が中心 — %3$lld個のアプリにまたがる%2$lld件のアイテム%4$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@이(가) 이번 주를 채워요 — 앱 %3$lld개%4$@에 걸쳐 항목 %2$lld개."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 填满了你这周 —— %3$lld 个应用里的 %2$lld 条内容%4$@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ llena tu semana: %2$lld elementos en %3$lld app%4$@."
          }
        }
      }
    },
