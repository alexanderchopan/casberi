            "state": "translated",
            "value": "Conectado — atento a la actividad."
          }
        }
      }
    },
    "Copy it and paste it below.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーして下に貼り付けてください。"
