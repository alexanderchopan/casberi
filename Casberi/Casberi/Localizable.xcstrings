        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "置き換えられました — %@ は実行されず、同じ nonce で別のトランザクションが通りました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "대체됨 — %@은(는) 실행되지 않았고, 같은 nonce로 다른 트랜잭션이 처리되었습니다"
          }
