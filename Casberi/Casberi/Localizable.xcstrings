        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용, 공개 데이터만. 좋아요는 나중에 로그인하면 들어와요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
