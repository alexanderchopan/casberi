    "“%@” links “%@” — you already saved it": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” links “%2$@” — you already saved it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” enlaza con “%@” — ya lo guardaste"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”は“%@”にリンクしています — すでに保存済みです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”은(는) “%@”로 연결됩니다 — 이미 저장한 항목입니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” 链接到 “%@” — 你已经保存过了"
          }
        }
      }
    },
    "“%@” on %@ just doubled its views": {
      "localizations": {
