    "Tap a chip — the feed takes that app's shape.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チップをタップすると、フィードがそのアプリの形になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "칩을 탭하세요 — 피드가 그 앱의 모습이 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "点一个标签 —— 订阅流会呈现那个应用的样子。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca un chip: el feed toma la forma de esa app."
          }
        }
      }
    },
    "Tap a pin to grow its card": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ピンをタップするとカードが拡大します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "고정 항목을 탭하면 카드가 펼쳐져요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
