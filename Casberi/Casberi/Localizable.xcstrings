    "Sign-in happens on Twitch's own page — a short code, no password in the app. Read-only: it can never chat, follow, or subscribe.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サインインはTwitch自身のページで行われます — 短いコードを使い、アプリにパスワードは入りません。読み取り専用で、チャットやフォロー、登録はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로그인은 Twitch 자체 페이지에서 이뤄져요 — 짧은 코드, 앱에는 암호를 입력하지 않아요. 읽기 전용: 채팅, 팔로우, 구독은 절대 할 수 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "登录在 Twitch 自己的页面上完成 —— 一个短代码，应用里不输密码。只读：它永远无法聊天、关注或订阅。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El inicio de sesión ocurre en la propia página de Twitch: un código corto, sin contraseña en la app. Solo lectura: nunca puede chatear, seguir ni suscribirse."
          }
        }
      }
    },
    "Steam": {},
    "Stop and keep": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "停止して残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "멈추고 유지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "停止并保留"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detener y conservar"
          }
        }
      }
    },
    "Stops new %@ things from landing. What already landed stays yours unless you remove it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しい%@のアイテムが届かなくなります。すでに届いたものは、削除しない限りそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 %@ 항목이 담기지 않게 멈춰요. 이미 담긴 것은 제거하지 않는 한 그대로 남아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "阻止新的 %@ 内容落地。已经落地的内容仍归你所有，除非你把它移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Evita que lleguen nuevos elementos de %@. Lo que ya llegó sigue siendo tuyo a menos que lo quites."
          }
        }
      }
    },
    "Swipe a token to pin it to Home and Feed, or to stop watching it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "トークンをスワイプすると、ホームとフィードにピン留めしたり、監視を止めたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "토큰을 스와이프해서 홈과 피드에 고정하거나 지켜보기를 멈추세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "滑动一个代币，把它置顶到主页和订阅流，或停止关注它。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desliza un token para fijarlo en Inicio y el feed, o para dejar de seguirlo."
          }
        }
      }
    },
    "Swipe a wallet to pin its holdings to Home and Feed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウォレットをスワイプすると、保有資産をホームとフィードにピン留めできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지갑을 스와이프해서 보유 자산을 홈과 피드에 고정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "滑动一个钱包，把它的持仓置顶到主页和订阅流。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desliza una cartera para fijar sus tenencias en Inicio y el feed."
          }
        }
      }
    },
    "t": {},
    "Tags": {
      "localizations": {
        "ja": {
