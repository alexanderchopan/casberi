    "Who @%@ follows. Pick any — their posts land like any watched account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A quién sigue @%@. Elige a cualquiera; sus publicaciones llegarán como las de cualquier cuenta seguida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "@%@がフォローしている相手。誰でも選べます — その投稿は監視中のアカウントと同じように届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "@%@이(가) 팔로우하는 사람들. 아무나 선택하세요 — 게시물은 지켜보는 계정과 동일하게 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "@%@ 关注的对象。选择任意一个——他们的帖子会像任何被关注的账户一样出现。"
          }
        }
      }
    },
    "Who do you read?": {
      "localizations": {
        "es": {
