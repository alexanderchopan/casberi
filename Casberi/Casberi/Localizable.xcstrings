          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura — nunca opera ni mueve fondos."
          }
        }
      }
    },
    "Read-only — nothing leaves this iPhone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用 — この iPhone から何も出ていきません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 — 아무것도 이 iPhone을 벗어나지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读 — 没有任何内容离开这台 iPhone。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura — nada sale de este iPhone."
          }
        }
      }
    },
    "Read-only — public price data only.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用 — 公開されている価格データのみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 — 공개 가격 데이터만."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读 — 仅公开价格数据。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura — solo datos de precio públicos."
          }
