    "A hand-picked set of people worth reading — follow all of them in one tap.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un grupo escogido a mano de gente que merece la pena leer: síguelos a todos en un toque."
          }
        },
