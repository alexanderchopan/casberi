      }
    },
    "You didn't send this. A spam token can announce any transfer it likes — it's advertising, not money that moved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tú no enviaste esto. Un token de spam puede anunciar cualquier transferencia que quiera: es publicidad, no dinero que se haya movido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これはあなたが送ったものではありません。スパムトークンは好きなように送金を告知できます — 実際に動いたお金ではなく、広告です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이것은 내가 보낸 것이 아닙니다. 스팸 토큰은 원하는 어떤 전송이든 알릴 수 있습니다 — 실제로 움직인 돈이 아니라 광고입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这不是你发送的。垃圾代币可以随意宣称任何转账 — 那是广告，而非真正流动的资金。"
          }
        }
      }
    },
    "You didn't send this. A spam token can announce any transfer it likes, including one from your address — it's advertising, not money that moved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tú no enviaste esto. Un token de spam puede anunciar cualquier transferencia que quiera, incluida una desde tu dirección; es publicidad, no dinero que se haya movido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これはあなたが送ったものではありません。スパムトークンは、あなたのアドレスからのものを含め、好きな送金を自由に発表できます — それは広告であり、実際に動いたお金ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이것은 회원님이 보낸 것이 아닙니다. 스팸 토큰은 회원님의 주소에서 보낸 것을 포함해 원하는 어떤 전송이든 알릴 수 있습니다 — 이는 광고일 뿐, 실제로 이동한 돈이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这不是你发送的。垃圾代币可以随意宣称任何转账，包括看似来自你地址的——这只是广告，并非真正移动的资金。"
          }
        }
      }
    },
