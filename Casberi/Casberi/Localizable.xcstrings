            "state": "translated",
            "value": "No se pudo actualizar %@ ahora mismo — puede que tu token guardado necesite renovarse."
          }
        }
      }
    },
    "Couldn't resolve %@ — check the name or paste a 0x address.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を解決できませんでした — 名前を確認するか、0x アドレスを貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 확인하지 못했어요 — 이름을 확인하거나 0x 주소를 붙여넣으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
