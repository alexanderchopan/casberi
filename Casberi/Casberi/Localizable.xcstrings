    },
    "Read-only, public boards only — secret boards never appear in the public feed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用、公開ボードのみ — 非公開ボードが公開フィードに出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용, 공개 보드만 — 비밀 보드는 공개 피드에 절대 나타나지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读，仅公开画板 — 私密画板绝不会出现在公开订阅源里。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura, solo tableros públicos — los tableros secretos nunca aparecen en el feed público."
          }
        }
      }
    },
    "Read-only, public data only — served by the Farcaster team's own public node.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用、公開データのみ — Farcaster チーム自身の公開ノードから提供されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
