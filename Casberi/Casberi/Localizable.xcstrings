    "Noticed here, not sent by Bitrefill. Fires once per crossing, re-arms when you top up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Detectado aquí, no enviado por Bitrefill. Se activa una vez por cruce y se rearma cuando recargas."
