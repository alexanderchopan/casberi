        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트로 피드에 들어와요 — 다른 것들처럼 찾을 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会作为笔记进入你的订阅流 — 和其他内容一样可查找。"
          }
