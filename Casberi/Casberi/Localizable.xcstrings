          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópialo y pégalo abajo."
          }
        }
      }
    },
    "Copy its Internal Integration Secret and paste it below.": {
      "localizations": {
        "ja": {
