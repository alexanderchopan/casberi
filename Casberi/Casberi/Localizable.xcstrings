    "Casberi keeps the things you care about — from every app — in one place you make your own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Casberi keeps the things you care about — from every app — in one place you make your own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casberi reúne lo que te importa —de todas tus apps— en un solo lugar que haces tuyo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Casberi 把你在意的一切——来自每个应用——汇聚到一个由你打造的地方。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Casberiは、あらゆるアプリからあなたの大切なものを、あなただけの場所にまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Casberi는 모든 앱에서 당신이 아끼는 것들을 당신만의 공간 한곳에 모아 둡니다."
          }
        }
      }
    },
    "Connect what's yours": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect what's yours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta lo tuyo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的内容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのものをつなぐ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 것을 연결하기"
          }
        }
      }
    },
    "Photos, a calendar, a wallet, a token. Casberi pulls those things in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, a calendar, a wallet, a token. Casberi pulls those things in."
          }
        },
        "es": {
