          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅限 Casberi — 你的设备语言保持不变。"
          }
        }
      }
    },
    "Casberi signs; it can't execute. Another owner sends it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Casberi firma; no puede ejecutar. Otro propietario la envía."
