          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入任意域名（casberi.app 即可）并复制密钥。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce cualquier dominio (casberi.app sirve) y copia la clave."
          }
        }
      }
    },
    "Enter your @icloud.com address and paste the password below.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@icloud.com のアドレスを入力し、下にパスワードを貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@icloud.com 주소를 입력하고 아래에 비밀번호를 붙여넣으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
