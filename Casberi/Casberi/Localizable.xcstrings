            "value": "内容"
          }
        }
      }
    },
    "Thinly traded — odds move easily": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poco negociado — las probabilidades cambian con facilidad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "取引が少ない — オッズが変動しやすい状態です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "거래량이 적습니다 — 배당률이 쉽게 변동됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "交易稀少 — 赔率容易发生变动"
