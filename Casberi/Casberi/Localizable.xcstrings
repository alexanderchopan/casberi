        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "盘口稀薄"
          }
        }
      }
    },
    "Thin book — few orders either side, so treat this number gently.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Libro poco profundo — pocas órdenes en ambos lados, así que interpreta este número con cautela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "薄い板です — 売り買いどちらの注文も少ないため、この数値は参考程度に見てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "얇은 호가창입니다 — 양쪽 모두 주문이 적으니 이 수치는 참고만 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "盘口稀薄 — 买卖双方挂单都很少，请谨慎看待这个数字。"
          }
        }
      }
    },
    "Thing": {
