    "Replaced after %@ — %@ never executed; a rival transaction went through at the same nonce instead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Replaced after %1$@ — %2$@ never executed; a rival transaction went through at the same nonce instead"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reemplazada tras %@: %@ nunca se ejecutó; en su lugar pasó una transacción rival con el mismo nonce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 後に置き換えられました — %@ は実行されず、同じ nonce で別のトランザクションが通りました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 후 대체됨 — %@은(는) 실행되지 않았고, 같은 nonce로 다른 트랜잭션이 처리되었습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 %@ 后被替换 — %@ 从未执行；同一 nonce 上另一笔交易通过了"
          }
        }
      }
    },
    "Replaced — %@ never executed; a rival transaction went through at the same nonce instead": {
      "localizations": {
