        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega a tu feed como una nota — localizable como todo lo demás."
          }
        }
      }
    },
    "Just the username — your public pins arrive through Pinterest's own feed, so there's no password to give.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名だけです — 公開ピンは Pinterest 自身のフィード経由で届くので、渡すパスワードはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 이름만 있으면 돼요 — 공개 핀은 Pinterest 자체 피드를 통해 들어오니, 줄 비밀번호가 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需用户名 — 你的公开图钉通过 Pinterest 自己的订阅源送达，所以无需提供密码。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el nombre de usuario — tus pines públicos llegan a través del propio feed de Pinterest, así que no hay contraseña que dar."
          }
        }
      }
    },
    "Key removed — your things stay.": {
