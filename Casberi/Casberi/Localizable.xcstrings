    "Kept on %@ for seven days, never synced. Forgetting them changes nothing about what's reached." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guardados en %@ durante siete días, nunca sincronizados. Olvidarlos no cambia nada de lo que se ha alcanzado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ に 7 日間保持され、同期されることはありません。削除しても、接続先には何の影響もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에 7일간 보관되며 동기화되지 않습니다. 삭제해도 접속한 대상에는 아무 영향이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
