        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "동기화할 때마다 확인합니다 — 승인되는 날 알려드립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
