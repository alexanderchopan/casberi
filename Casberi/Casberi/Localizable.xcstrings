    "This iPhone can't share financial data. Apple Card, Apple Cash and Savings are US-only, and this needs iOS 17.4 or later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este iPhone no puede compartir datos financieros. Apple Card, Apple Cash y Ahorros solo están disponibles en EE. UU., y esto requiere iOS 17.4 o posterior."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この iPhone は金融データを共有できません。Apple Card、Apple Cash、貯蓄は米国のみで利用でき、iOS 17.4 以降が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
