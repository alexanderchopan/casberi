    "%lld on record %@. Name the chains you use and L2BEAT's assessment of each arrives too — who can stop your transactions, and how long you'd have to get out." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld on record %2$@. Name the chains you use and L2BEAT's assessment of each arrives too — who can stop your transactions, and how long you'd have to get out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld registrados %@. Indica las cadenas que usas y llegará también la evaluación de L2BEAT de cada una: quién puede detener tus transacciones y cuánto tiempo tendrías para salir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ に %lld 件の記録があります。利用しているチェーンを指定すると、各チェーンに対する L2BEAT の評価も届きます — 誰があなたの取引を止められるのか、そして資金を引き出すのにどれだけの猶予があるのか。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ %lld건이 기록되어 있습니다. 사용하는 체인을 지정하면 각 체인에 대한 L2BEAT의 평가도 함께 도착합니다 — 누가 거래를 멈출 수 있는지, 자금을 빼내는 데 얼마나 시간이 있는지."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@共记录 %lld 起。指定你使用的链，L2BEAT 对每条链的评估也会一并送达 — 谁能中止你的交易，以及你有多长时间撤出资金。"
          }
        }
      }
    },
    "%lld on record %@. Watching yours adds who can stop your transactions, and how long you'd have to get out." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld on record %2$@. Watching yours adds who can stop your transactions, and how long you'd have to get out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld registrados %2$@. Vigilar el tuyo añade quién puede detener tus transacciones y cuánto tiempo tendrías para salir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "記録は %1$lld 件 %2$@ です。自分のアカウントをウォッチすると、誰が取引を止められるか、逃げる猶予がどれくらいあるかが加わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기록상 %1$lld개 %2$@. 내 계정을 감시하면 누가 내 거래를 중지할 수 있는지와 빠져나갈 시간이 얼마나 되는지가 추가됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "记录中有 %1$lld 个 %2$@。关注你自己的账户，会显示谁能阻止你的交易，以及你有多长时间可以撤出。"
          }
        }
      }
    },
