      }
    },
    "Read-only, public data only. Likes arrive with sign-in, later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用、公開データのみ。いいねはサインイン後、後日届きます。"
