            "value" : "あなたの閲覧は%@を中心に回っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "회원님의 읽기 기록은 계속 %@ 주변을 맴돌고 있습니다."
          }
