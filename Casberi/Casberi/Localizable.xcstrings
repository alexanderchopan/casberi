      }
    },
    "Read-only — public profile data.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用 — 公開プロフィールデータのみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 — 공개 프로필 데이터."
          }
