    },
    "That file isn't a Kindle export. Pick My Clippings.txt from the Kindle's documents folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "そのファイルはKindleのエクスポートではありません。Kindleのdocumentsフォルダから My Clippings.txt を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
