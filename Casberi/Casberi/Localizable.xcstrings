        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ への送金に登場しました。まだ名前を付けていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@(으)로의 전송에 나타났습니다. 아직 이름을 지정하지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
