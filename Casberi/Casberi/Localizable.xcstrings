          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "あなたのアカウントのうち %lld 件はスマートアカウントで、インストール済みモジュールは一覧表示できません — このアプリはそれがスマートアカウントであることは分かりますが、中身は分かりません。"
          }
