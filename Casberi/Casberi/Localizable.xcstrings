    "Authorize once and the cards assigned to you keep arriving with their due dates. Trello is asked for a read-only token, so it has no write permission to give.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriza una vez y las tarjetas asignadas a ti seguirán llegando con sus fechas de vencimiento. A Trello se le pide un token de solo lectura, así que no tiene permiso de escritura que conceder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一度承認すれば、あなたに割り当てられたカードが期日とともに届き続けます。Trello には読み取り専用トークンを要求するため、書き込み権限は付与されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "한 번 승인하면 나에게 배정된 카드가 기한과 함께 계속 도착합니다. Trello에는 읽기 전용 토큰을 요청하므로 쓰기 권한이 부여되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "授权一次，分配给你的卡片就会带着截止日期持续到达。我们向 Trello 申请的是只读令牌，因此它无法授予写入权限。"
          }
        }
      }
    },
    "Authorize read-only access": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorizar acceso de solo lectura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "読み取り専用アクセスを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "읽기 전용 액세스 승인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "授权只读访问"
          }
        }
      }
    },
    "Authorized %@. The amount can still change until it settles.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorizado %@. El importe aún puede cambiar hasta que se liquide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ に承認されました。確定するまで金額は変わる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에 승인되었습니다. 정산될 때까지 금액이 바뀔 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已于 %@ 授权。在结算之前金额仍可能变动。"
          }
        }
      }
    },
    "Auto-renew is off. Nothing will renew this for you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La renovación automática está desactivada. Nada renovará esto por ti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自動更新はオフです。何もあなたの代わりに更新しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자동 갱신이 꺼져 있습니다. 아무것도 대신 갱신해 주지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自动续订已关闭。不会有任何东西替你续订。"
          }
        }
      }
