            "value": "Texto"
          }
        }
      }
    },
    "The key stays in this iPhone's Keychain and goes only to Steam itself. Read-only — public profile data.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キーはこのiPhoneのKeychainに保管され、Steam本体にだけ送られます。読み取り専用 — 公開プロフィールのデータです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키는 이 iPhone의 Keychain에 남아 Steam 자체로만 전송돼요. 읽기 전용 — 공개 프로필 데이터."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密钥留在这台 iPhone 的 Keychain 里，只发给 Steam 本身。只读 —— 公开的个人资料数据。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clave se queda en el Keychain de este iPhone y va solo a Steam. Solo lectura: datos públicos de perfil."
          }
        }
      }
    },
    "The name changes on every thing that carries it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "その名前が付いたすべてのアイテムで名前が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그 이름을 가진 모든 항목에서 이름이 바뀌어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "带有它的每条内容都会改成新名称。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El nombre cambia en todos los elementos que lo llevan."
          }
        }
      }
    },
    "The token stays in this iPhone's Keychain and goes only to %@ itself. Read-only.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "トークンはこのiPhoneのKeychainに保管され、%@本体にだけ送られます。読み取り専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "토큰은 이 iPhone의 Keychain에 남아 %@ 자체로만 전송돼요. 읽기 전용."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "令牌留在这台 iPhone 的 Keychain 里，只发给 %@ 本身。只读。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El token se queda en el Keychain de este iPhone y va solo a %@. Solo lectura."
          }
        }
      }
    },
    "There was nothing to save.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存するものはありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장할 것이 없었어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有可保存的内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No había nada que guardar."
          }
        }
      }
    },
    "Things keep their content — only the tag goes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アイテムの内容はそのまま — タグだけが消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "항목의 내용은 그대로 — 태그만 사라져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "内容会保留 —— 只有标签会被移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los elementos conservan su contenido: solo se quita la etiqueta."
          }
        }
      }
