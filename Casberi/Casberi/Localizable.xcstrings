          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "전송에 나타났습니다. 아직 이름을 지정하지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它出现在一笔转账中。你还没有为它命名。"
          }
        }
      }
    },
    "They assess %lld chains so far." : {
      "localizations" : {
