    },
    "Couldn't sign in — check the address and app-specific password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインできませんでした — アドレスとアプリ用パスワードを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하지 못했어요 — 주소와 앱 암호를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法登录 — 检查地址和应用专用密码。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión — revisa la dirección y la contraseña específica de app."
          }
        }
      }
    },
    "Create a key — read access is enough.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを作成してください — 読み取りアクセスで十分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 생성하세요 — 읽기 권한이면 충분해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个密钥 — 只读权限就够了。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una clave — con acceso de lectura basta."
          }
        }
      }
    },
    "Create an app password named “Casberi” and copy it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Casberi」という名前のアプリパスワードを作成してコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“Casberi”라는 이름의 앱 비밀번호를 만들고 복사하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个名为“Casberi”的应用密码并复制它。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una contraseña de app llamada “Casberi” y cópiala."
          }
        }
      }
    },
    "Create an app, then copy its Test token.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを作成し、その Test トークンをコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 만든 다음 Test token을 복사하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个应用，然后复制它的 Test token。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una app y luego copia su Test token."
          }
        }
      }
    },
    "Disconnected — your things stay.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を解除しました — あなたの thing は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 해제됨 — 내 항목은 그대로 남아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开连接 — 你的内容会保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado — tus cosas se quedan."
          }
        }
      }
    },
    "Does work when you ask.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頼めば作業を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청하면 작업을 수행해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你需要时干活。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace tareas cuando lo pides."
          }
        }
      }
    },
    "Drafts replies when you ask.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頼めば返信の下書きを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청하면 답장 초안을 작성해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你需要时起草回复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacta respuestas cuando lo pides."
          }
        }
      }
    },
    "Enter any domain (casberi.app works) and copy the key.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のドメイン（casberi.app でも可）を入力し、キーをコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
