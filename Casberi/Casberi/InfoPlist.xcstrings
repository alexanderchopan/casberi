          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Casberi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casberi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Casberi"
          }
        },
        "ko": {
