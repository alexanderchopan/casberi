{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Casberi"
          }
