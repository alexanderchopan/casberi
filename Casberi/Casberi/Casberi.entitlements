<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<!-- FinanceKit — granted by Apple 2026-08-06 for team 35428TQK3S /
	     com.casberi.app (request QVDBMBPMJU). Reads Apple Card, Apple Cash and
	     Savings transactions and balances, on device, after the person grants
	     it per-account through Apple's own prompt.
	     iOS ONLY, deliberately: this key is absent from
	     Casberi-Catalyst.entitlements because FinanceKit declares
	     `@available(macOS, unavailable)`, and an entitlement the Mac
	     provisioning profile doesn't carry fails a signed archive. The code is
	     gated to match (`AppleWalletBridge` compiles out under macCatalyst), so
	     the seat simply never appears there — which is what we told Apple on
	     the request form (iOS now, macOS as future interest). -->
	<key>com.apple.developer.financekit</key>
	<array>
		<string>financial-data</string>
	</array>
	<!-- Time Sensitive Notifications — the key that makes prd §306's two
	     deadline alarms (a dispute with evidence due, a closing window) able to
	     break through a Focus. `Notifications.swift` has always SET
	     `interruptionLevel = .timeSensitive` for those two kinds; without this
	     key iOS silently caps it to `.active`, which is the §83 fake-status
	     shape in the one place with no screen to inspect — nothing fails, no
	     log line appears, and the notification arrives looking exactly right.
	     HOW IT GOT ONTO THE APP ID, measured 2026-08-14, because the two
	     obvious routes disagree. `POST /v1/bundleIdCapabilities` with
	     `TIME_SENSITIVE_NOTIFICATIONS` answers 409 and lists 28 valid
	     `capabilityType` values, none of them this one — so the App Store
	     Connect API cannot WRITE it. `xcodebuild -allowProvisioningUpdates`
	     with an ASC key CAN: it registered the capability and regenerated the
	     profile in one build. The same API then READS it back under a third
	     spelling, `USERNOTIFICATIONS_TIMESENSITIVE`, which is why guessing the
	     write name got nowhere. Present in the Catalyst sibling too, since
	     macOS honours interruption levels as well — unlike FinanceKit below,
	     there is no availability reason to split them, and the Catalyst build
	     is SIGNED, so `verify.sh` fails there the moment the profile lacks
	     this key. That is the check that caught it: the iOS Simulator build is
	     unsigned and went green with the profile still missing it. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.casberi.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- The address book's mirror (AddressBookSync). Names live in
	     UserDefaults rather than the model container, so CloudKit's mirroring
	     never carried them; this is what lets them reach a second device.
	     Gated at runtime on the same `icloud.sync` toggle the corpus uses. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- The app group alone carries keychain sharing on iOS: every group in
	     application-groups is automatically a valid keychain access group, so
	     the WalletConnect SDK's kSecAttrAccessGroup = group.com.casberi.app
	     write is authorized by THIS key. Do not re-add a keychain-access-groups
	     entry for it (tried 2026-07-24, removed 2026-08-01): the provisioning
	     profile only allows keychain-access-groups matching 35428TQK3S.*, so an
	     unprefixed group.* entry fails a signed archive — and its first entry
	     would also silently move TokenVault's DEFAULT access group away from
	     the app identifier every shipped install stores its keys under. The
	     -34018 it was meant to fix was never a missing key here: the old
	     unsigned-archive ship pipeline stripped ALL entitlements from every
	     TestFlight build (see scripts/testflight.sh). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.casberi.app</string>
	</array>
</dict>
</plist>
