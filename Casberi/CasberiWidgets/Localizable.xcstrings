{
  "sourceLanguage": "en",
  "strings": {
    "Opens Casberi's composer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre el editor de Casberi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Casberi の入力欄を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Casberi 입력창을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开 Casberi 的输入框。"
          }
        }
      }
    },
    "Opens the composer from Control Center.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre el editor desde el Centro de control."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コントロールセンターから入力欄を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제어 센터에서 입력창을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从控制中心打开输入框。"
          }
        }
      }
    },
