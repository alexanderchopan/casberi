          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Síntesis"
          }
        }
      }
    },
    "One line about what your things are up to.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "用一句话概括你的内容动态。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのアイテムの近況を一行で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "항목들의 근황을 한 줄로."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una línea sobre tus elementos."
          }
        }
      }
    },
