    "Your things go here": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的内容会出现在这里"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ここにあなたのアイテムが表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기에 항목이 표시돼요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquí van tus elementos"
          }
        }
