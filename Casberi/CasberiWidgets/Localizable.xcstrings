          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ahora"
          }
        }
      }
    },
    "Your things, one place": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的内容，尽在一处"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのアイテムを一か所に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 항목을 한곳에"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus elementos, en un lugar"
          }
        }
