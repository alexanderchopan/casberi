      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本周"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今週"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이번 주"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta semana"
          }
        }
      }
    },
    "Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
