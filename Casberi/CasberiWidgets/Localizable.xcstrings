            "value": "录音中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "録音中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "녹음 중"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grabando"
          }
        }
      }
    },
    "Save a thing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存内容"
          }
        },
        "ja": {
          "stringUnit": {
