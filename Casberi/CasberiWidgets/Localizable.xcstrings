            "value": "항목 저장"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guardar algo"
          }
        }
      }
    },
    "Opens Casberi's composer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开 Casberi 的输入框。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Casberi の入力欄を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Casberi 입력창을 엽니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre el editor de Casberi."
          }
        }
      }
    },
    "Save to Casberi": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存到 Casberi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Casberi に保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Casberi에 저장"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guardar en Casberi"
          }
        }
      }
    },
    "Opens the composer from Control Center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从控制中心打开输入框。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コントロールセンターから入力欄を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제어 센터에서 입력창을 엽니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre el editor desde el Centro de control."
          }
        }
      }
    },
    "Synthesis": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "综述"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まとめ"
          }
