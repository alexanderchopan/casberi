<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Catalyst twin of ShareExtension.entitlements — same reasoning as
	     Casberi-Catalyst.entitlements: macOS team-prefixes an app group, iOS
	     does not, so the iOS file stays untouched. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.com.casberi.app</string>
	</array>
</dict>
</plist>
