<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store distribution, uploaded straight to App Store Connect. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>35428TQK3S</string>
	<!-- Let Xcode create/refresh the distribution profiles for all 3 targets. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Manage app version + build automatically is off; we bump in the script. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
