 "exempt": [
  {
   "covers": [
    "Screens/AccountScreen.swift:detail#data",
    "Screens/AccountScreen.swift:detail#notifications",
    "Screens/AccountScreen.swift:languageOpen",
    "Screens/AccountScreen.swift:chipOrderOpen",
    "Screens/AccountScreen.swift:diagnosticsOpen"
   ],
   "why": "on the phone Settings is already a sheet, so AccountScreen.open pushes the row's page (route.sheet#node.settingsPage, swept as settings-*); these rise only on iPad/Mac outside the pane"
  },
  {
   "covers": [
    "Screens/FeedScreen+Sheets.swift:feedSheet#allocation",
    "Screens/FeedScreen+Sheets.swift:feedSheet#web",
    "Screens/SettingsHome.swift:sheet#followAdd"
   ],
   "why": "no code sets it: the door that raised it is gone (see the spawned cleanup)"
  },
  {
   "covers": [
    "Screens/SettingsHome.swift:sheet#socialFollow"
   ],
   "why": "its only setter is the Following count's plus, which lists Media's apps; FollowByName lands Bluesky and Telegram nowhere in that menu, so no phone path reaches it"
  },
  {
   "covers": [
    "Shell/MainSurface.swift:route.sheet#node.project"
   ],
   "why": "its themes-map door is gone; only the composer's `show <topic>` reaches it, which the sweep does not type"
  },
  {
   "covers": [
    "Screens/FeedScreen+Sheets.swift:feedSheet#nftPicks"
   ],
   "why": "both Choose collections controls hide while DemoMode.isActive, and the sweep runs in the demo"
  },
  {
   "covers": [
    "Screens/FeedScreen+Sheets.swift:feedSheet#socialFaces",
    "Shell/MainSurface.swift:allFacesShown"
   ],
   "why": "the More face needs more than eight people (the demo has two); allFacesShown is also iPad/Mac only (showsRail)"
  },
  {
   "covers": [
    "Screens/FeedScreen+Sheets.swift:feedSheet#walletTokens"
   ],
   "why": "the More tokens row draws only when Holdings folds two or more small tokens; the demo's four tokens each stand on their own row (measured 2026-10-14)"
  },
  {
   "covers": [
    "Screens/AddressesScreen.swift:asked"
   ],
   "why": "Same person? rises only for a pair ContactSuggest proposes; the demo's addresses propose none"
  },
  {
   "covers": [
    "Screens/MarketsViews.swift:tray#edit",
    "Screens/FeedScreen.swift:folderShare",
    "Screens/ThingSheetView.swift:faceTarget#remind",
    "Screens/ThingSheetView.swift:sharingHighlight"
   ],
   "why": "NOT WALKED YET: each needs something made first the demo does not carry (an alert, a vault folder, a kept checklist, a kept highlight); open, not settled"
  },
  {
   "covers": [
    "Screens/FeedScreen+Sheets.swift:feedSheet#logosSend",
    "Screens/FeedScreen+Sheets.swift:feedSheet#logosChat"
   ],
   "why": "Send needs a Logos key made on this phone and chats need a paired Observer node; the demo has neither"
  },
  {
   "covers": [
    "Screens/FeedScreen+Sheets.swift:feedSheet#subscriptionTrack"
   ],
   "why": "raised once after an app's first real connect (SubscriptionPlans.shouldAsk); the demo's apps are poured, never connected"
  },
  {
   "covers": [
    "Screens/SocialPostViews.swift:profile@2"
   ],
   "why": "reply avatars come from a live thread fetch; the demo has no replies to tap"
  },
  {
   "covers": [
    "Screens/DiagnosticsScreen.swift:capturing#youtube",
    "Screens/DiagnosticsScreen.swift:capturing#podcasts",
    "Screens/DiagnosticsScreen.swift:capturing#pinterest",
    "Screens/DiagnosticsScreen.swift:capturing#github",
    "Screens/DiagnosticsScreen.swift:capturing#npm",
    "Screens/DiagnosticsScreen.swift:capturing#pypi",
    "Screens/DiagnosticsScreen.swift:capturing#huggingFace",
    "Screens/DiagnosticsScreen.swift:capturing#radicle"
   ],
   "why": "DEBUG-only measurement covers in Diagnostics, which the phone reaches only by the -openDiagnostics hook; never seen by a person"
  },
  {
   "covers": [
    "Shell/MainSurface.swift:route.sheet#node.apps"
   ],
   "why": "present(.apps) is rewritten to .casberi (HomeRoute.present, prd §1234), so this sheet is node.casberi's, swept as `sources`"
  },
  {
   "covers": [
    "Screens/ShareTray.swift:composer#messages",
    "Screens/ShareTray.swift:composer#mail",
    "Screens/AddressesScreen.swift:composer#messages",
    "Screens/AddressesScreen.swift:composer#mail"
   ],
   "why": "MessageCompose.canText and canMail are false on the simulator (no Messages or Mail account), so the rows that raise Apple's composers never draw there"
  },
  {
   "covers": [
    "Shell/NoteCaptureSheet.swift:scanOpen"
   ],
   "why": "the document camera needs a camera; the simulator has none, so Attach offers no Scan there"
  },
  {
   "covers": [
    "Screens/ShareTray.swift:activityUp@2"
   ],
   "why": "the same ActivitySheet as `share-system`, drawn only when a thing's share card cannot render"
  },
  {
   "covers": [
    "Shell/RootShell.swift:safeAsk",
    "Screens/SafeScreen.swift:pastedAsk"
   ],
   "why": "raised by a live Safe pairing (SafePeer) or a pasted ask from it; there is no Safe on the simulator to ask"
  },
  {
   "covers": [
    "Shell/RootShell.swift:aztecSign",
    "Screens/AztecScreen.swift:pastedSign"
   ],
   "why": "raised by a signing link from the Aztec wallet; there is no peer on the simulator to make one"
  },
  {
   "covers": [
    "Shell/RootShell.swift:observerOffer",
    "Screens/LogosScreen.swift:pairOffer"
   ],
   "why": "raised by a logos-observer pairing offer from a Logos node; there is no node on the simulator"
  }
 ]
}
