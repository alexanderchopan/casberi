# macOS
.DS_Store

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build products (builds go to ~/Library/Developer/CasberiDD — never in-repo)
build/
DerivedData/

# Verify script output
scripts/output/

# Website deploy artifact (regenerated on each deploy)
website/*.zip

# Claude Code personal settings
.claude/settings.local.json

# Launch-video renders are large regenerable outputs — keep source (scripts + shot frames), not the mp4s
design/launch-video/*.mp4

# Session scratch (agent working files — never repo content)
scratchpad/

# Root-level deploy artifact (the deployable copy lives in ~/Downloads per rule)
website-deploy.zip

# Launch-video render intermediates (regenerated by the build-*/record-* scripts)
design/launch-video/frames/
design/launch-video/rec-apple-vid-out/
design/launch-video/rec-farcaster-out/
__pycache__/
