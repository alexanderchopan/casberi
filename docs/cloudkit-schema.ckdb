DEFINE SCHEMA

    RECORD TYPE CD_Thing (
        CD_audio                BYTES QUERYABLE SORTABLE,
        CD_authorAvatarURL      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_authorHandle         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_capturedAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_channelName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_content              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_counterpartyAddress  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_detectedAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_detectedMailto       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_detectedPlace        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_detectedTel          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_detectionVersion     INT64 QUERYABLE SORTABLE,
        CD_dueAt                TIMESTAMP QUERYABLE SORTABLE,
        CD_embedding            BYTES QUERYABLE SORTABLE,
        CD_endAt                TIMESTAMP QUERYABLE SORTABLE,
        CD_enrichedText         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_externalLink         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_facts                BYTES QUERYABLE SORTABLE,
        CD_grantedAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_id                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_imageURLs            BYTES QUERYABLE SORTABLE,
        CD_kind                 BYTES QUERYABLE SORTABLE,
        CD_likeCount            INT64 QUERYABLE SORTABLE,
        CD_mark                 BYTES QUERYABLE SORTABLE,
        CD_marketResolvedYes    INT64 QUERYABLE SORTABLE,
        CD_messageCount         INT64 QUERYABLE SORTABLE,
        CD_ocrAt                TIMESTAMP QUERYABLE SORTABLE,
        CD_ocrTopics            BYTES QUERYABLE SORTABLE,
        CD_parent               BYTES QUERYABLE SORTABLE,
        CD_pinnedAt             TIMESTAMP QUERYABLE SORTABLE,
        CD_postAuthor           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_postText             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_previewImageData     BYTES QUERYABLE SORTABLE,
        CD_previewImageURL      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_priceCurrency        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_priceValue           DOUBLE QUERYABLE SORTABLE,
        CD_provenance           BYTES QUERYABLE SORTABLE,
        CD_quote                BYTES QUERYABLE SORTABLE,
        CD_replyCount           INT64 QUERYABLE SORTABLE,
        CD_repoLanguage         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_repostCount          INT64 QUERYABLE SORTABLE,
        CD_securityFlag         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_socialContext        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_source               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceRef            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_spoofedSymbol        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_starCount            INT64 QUERYABLE SORTABLE,
        CD_summary              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_tags                 BYTES QUERYABLE SORTABLE,
        CD_title                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_topicsAt             TIMESTAMP QUERYABLE SORTABLE,
        CD_transferAmount       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_transferCounterparty STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_transferDirection    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_transferUSD          DOUBLE QUERYABLE SORTABLE,
        CD_transferVenue        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_walletAddress        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_watchPriceUsd        DOUBLE QUERYABLE SORTABLE,
        CD_wikilinks            BYTES QUERYABLE SORTABLE,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

